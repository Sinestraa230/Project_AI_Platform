# Cấu hình nginx cho image frontend. ${BACKEND_UPSTREAM} được thay lúc container
# khởi động (entrypoint của image nginx chạy envsubst) — mặc định http://backend:8000.
server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Ảnh chẩn đoán gửi kèm kết quả (backend giới hạn MAX_UPLOAD_MB=4)
  client_max_body_size 5m;

  gzip on;
  gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

  # API và health -> backend (cùng origin với trang web nên không cần CORS)
  location /api/ {
    proxy_pass ${BACKEND_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  location = /health {
    proxy_pass ${BACKEND_UPSTREAM};
    proxy_set_header Host $host;
  }

  # Model .tflite và runtime wasm: tên có phiên bản/hash -> cache lâu dài
  location ~ ^/model/.*/plant_disease_model\.tflite$ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location ~ ^/(litert|assets)/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # SPA: F5 ở /history, /diagnosis... vẫn về index.html
  location / {
    try_files $uri $uri/ /index.html;
  }
}
