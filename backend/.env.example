# Backend (copy thành backend/.env; đường dẫn tương đối tính từ backend/)
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./app.db

# AI
AI_MODEL_PATH=ai_artifacts/plant_disease_model.keras
AI_CLASS_MAPPING_PATH=ai_artifacts/class_mapping.json
AI_MODEL_VERSION=efficientnetb3_v1.0
AI_IMG_SIZE=300
TOP_K=5
CONFIDENCE_THRESHOLD=0.6

# Upload
MAX_UPLOAD_MB=10

SAVE_TO_DB=false
