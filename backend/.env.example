# Backend (copy thành backend/.env; đường dẫn tương đối tính từ backend/)
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./app.db

# AI
AI_MODEL_PATH=ai_artifacts/plant_disease_model.keras
AI_CLASS_MAPPING_PATH=ai_artifacts/class_mapping.json
# Phiên bản thật đọc từ ai_artifacts/model_info.json; giá trị này chỉ dùng cho model cũ chưa có file đó
AI_MODEL_VERSION=efficientnetb3_v1.0
AI_IMG_SIZE=300
TOP_K=5
CONFIDENCE_THRESHOLD=0.6

# Nguồn model: Hugging Face Hub (notebook Kaggle tự upload lên đây)
HF_REPO_ID=NamHai0510/plant-disease-model
# Token loại Read tạo tại huggingface.co/settings/tokens (repo private -> cần được mời vào repo)
HF_TOKEN=
# Rỗng = bản mới nhất (main). Đặt tag, VD efficientnetb3-20261109-1430 (xem tab "Tags" trên HF), để cả team dùng cùng 1 bản
HF_REVISION=
# Thiếu model khi khởi động -> tự tải
AUTO_DOWNLOAD_MODEL=true

# Upload
MAX_UPLOAD_MB=10

# Lưu lịch sử dự đoán (trang History cần bật)
SAVE_TO_DB=true
