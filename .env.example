# =====================================================================
# File cấu hình DÙNG CHUNG cho cả project (backend + frontend + ai-service).
# Copy file này thành .env ở cùng thư mục (gốc project) rồi điền giá trị.
# .env đã bị git bỏ qua — KHÔNG BAO GIỜ commit token / mật khẩu.
#
# Để trống = dùng giá trị mặc định (ghi trong ngoặc ở mỗi dòng mô tả).
# Khi deploy trên Vercel: KHÔNG dùng file này, đặt biến trong
# Vercel > Project > Settings > Environment Variables (xem mục "Deploy" trong README.md).
# =====================================================================


# ---------------------------------------------------------------------
# Hugging Face — nơi chứa model (repo hiện public)
# ---------------------------------------------------------------------
# Token tạo tại https://huggingface.co/settings/tokens
#   - loại Read: tải model / chạy backend/scripts/sync_model_meta.py (chỉ cần nếu repo private)
#   - loại Write: notebook / ai-service upload model mới
HF_TOKEN=
# Repo model (mặc định: NamHai0510/plant-disease-model)
HF_REPO_ID=
# Phiên bản dùng khi upload/tải thủ công (ai-service). Frontend/backend KHÔNG dùng biến này:
# phiên bản do backend/app/data/model/model_info.json quyết định.
HF_REVISION=


# ---------------------------------------------------------------------
# Kaggle (ai-service, tuỳ chọn — Kaggle CLI vẫn dùng kaggle.json riêng)
# ---------------------------------------------------------------------
KAGGLE_USERNAME=


# ---------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------
# development | production (mặc định: development)
APP_ENV=
# Chuỗi kết nối database (mặc định: SQLite backend/app.db).
# Neon: postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# Trên Vercel BẮT BUỘC đặt (thiếu thì app báo lỗi và không chạy).
DATABASE_URL=
# Domain frontend được gọi API, cách nhau bằng dấu phẩy (mặc định: * = cho tất cả).
# Production: https://<project-frontend>.vercel.app
CORS_ORIGINS=
# Ngưỡng "đủ chắc chắn" khi lưu lịch sử VÀ hiển thị trên trang Chẩn đoán (mặc định: 0.6)
CONFIDENCE_THRESHOLD=
# Số kết quả top-k lưu lại (mặc định: 5)
TOP_K=
# Lưu kèm ảnh đã chẩn đoán: true | false (mặc định: true)
SAVE_IMAGES=
# Nơi lưu ảnh: disk | db (mặc định: disk; trên Vercel tự dùng db)
IMAGE_STORAGE=
# Thư mục lưu ảnh khi IMAGE_STORAGE=disk, tính từ backend/ (mặc định: uploads)
UPLOAD_DIR=
# Cạnh dài nhất của ảnh lưu lại, px (mặc định: 1024)
IMAGE_MAX_SIDE=
# Dung lượng ảnh tối đa gửi lên, MB (mặc định: 4 — Vercel giới hạn body 4.5MB)
MAX_UPLOAD_MB=
# Số ngày phiên đăng nhập còn hiệu lực (mặc định: 7)
SESSION_TTL_DAYS=


# ---------------------------------------------------------------------
# Frontend (React + Vite)
# ---------------------------------------------------------------------
# Địa chỉ backend, không có dấu / ở cuối.
# Để trống khi dev: Vite tự proxy /api sang http://localhost:8000.
# Production: https://<project-backend>.vercel.app (đổi giá trị thì phải build lại)
VITE_API_URL=
# CI: đặt 1 để bỏ qua bước lấy model 43MB khi build (mặc định: trống = có lấy)
SKIP_MODEL_DOWNLOAD=
